{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  // The SEO kit's build half runs under Node, not in the browser bundle;
  // it is type-checked by tsconfig.node.json instead.
  "exclude": ["src/**/__tests__/*", "src/kit/seo/stamp.ts", "src/kit/seo/plugin.ts", "src/kit/seo/postbuild.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
